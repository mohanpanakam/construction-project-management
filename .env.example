# Copy this file to `.env` (same folder as docker-compose.prod.yml) and fill in real
# values. NEVER commit the real .env file — it's already covered by .gitignore rules
# for *.env, but double-check before pushing.

# Postgres (runs inside Docker on the EC2 instance — not exposed publicly)
DB_USER=postgres
DB_PASSWORD=changeme-use-a-strong-password

# Signs/verifies session JWTs — generate a long random value, e.g.:
#   openssl rand -base64 48
# NEVER reuse the insecure dev fallback in JwtConfig.kt for production.
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48

# Real AWS S3 bucket for project files / photos / receipts
S3_BUCKET=construction-files-yourname
AWS_REGION=ap-south-1

# IAM user access keys (scoped to S3 only — see README for the least-privilege policy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

